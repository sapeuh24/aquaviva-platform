APP_NAME="Aquaviva"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aquaviva
DB_USERNAME=aquaviva
DB_PASSWORD=aquaviva_secret

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@aquaviva.local"
MAIL_FROM_NAME="Aquaviva"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1
SESSION_DOMAIN=localhost

# Evidencias
EVIDENCE_RETENTION_YEARS=5
EVIDENCE_MAX_FILE_SIZE_KB=51200
EVIDENCE_STORAGE_PATH=evidences
